# Copy to keys.env (git-ignored). Only the provider you use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VLLM_API_KEY=
# Fine-grained token or GitHub App installation token: ONE repo, contents:write + pull_requests:write
GITHUB_TOKEN=
# Optional: HMAC key for the audit chain (otherwise plain SHA-256 chaining)
AGENTIC_AUDIT_KEY=
# Optional traces of every agent run and tool call (pick one)
PHOENIX_COLLECTOR_ENDPOINT=   # self-hosted Arize Phoenix, e.g. http://localhost:6006 (pip install -e ".[phoenix]")
LOGFIRE_TOKEN=                # hosted Pydantic Logfire (pip install -e ".[observability]")
